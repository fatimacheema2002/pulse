# Which model backend to use: local | meta | open_weights | offline (keyword baseline)
# Leave empty to choose automatically: Meta Model API if a key is set, else local Ollama if it is running.
PULSE_BACKEND=

# --- On this computer with Ollama: no API key needed ---
PULSE_LOCAL_BASE_URL=http://localhost:11434
# Leave empty to use the best Meta model installed (muse-glimmer:30b, then llama3.1:8b, then llama3.2:3b)
PULSE_LOCAL_MODEL=
# Context window requested from Ollama. Its default of 4096 silently cuts Pulse's prompt.
PULSE_NUM_CTX=8192

# --- Meta Model API (Muse Spark), optional ---
MODEL_API_KEY=
PULSE_META_MODEL=muse-spark-1.3
# Do not use muse-spark-1.3-contributor with real employee data: it lets Meta train on prompts and completions.

# --- Open weights on a server (vLLM, SGLang, Baseten, Fireworks, Modal...), optional ---
PULSE_OPEN_BASE_URL=http://localhost:8000/v1
PULSE_OPEN_MODEL=meta-models/Muse-Glimmer-30B
PULSE_OPEN_API_KEY=

# --- Tuning (defaults depend on the backend: local uses 4 comments per request, one request at a time) ---
PULSE_BATCH_SIZE=
PULSE_MAX_WORKERS=
PULSE_RECHECK=1
PULSE_MIN_GROUP_SIZE=5
# Extra words to redact everywhere, comma-separated (e.g. site nicknames, client names)
PULSE_REDACT_TERMS=
